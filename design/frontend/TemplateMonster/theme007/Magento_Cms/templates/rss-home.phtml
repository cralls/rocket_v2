$chevronIconUrl = $block->getViewFileUrl('images/rss/chevron-down.svg');
$silverPodiumUrl = $block->getViewFileUrl('images/rss/silver-podium.svg');
$goldPodiumUrl = $block->getViewFileUrl('images/rss/gold-podium.svg');
$bronzePodiumUrl = $block->getViewFileUrl('images/rss/bronze-podium.svg');
