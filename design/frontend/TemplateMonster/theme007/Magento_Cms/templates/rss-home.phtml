$getVisibleChildren = static function ($category) {
    $children = [];

    if (!$category) {
        return $children;
    }

    foreach ($category->getChildrenCategories() as $child) {
        if (!$child->getIsActive()) {
            continue;
        }

        if ($child->hasData('include_in_menu') && !$child->getIncludeInMenu()) {
            continue;
        }

        $children[] = $child;
    }

    return $children;
};

