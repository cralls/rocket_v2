                <img src="<?= $block->escapeUrl($cartIconUrl) ?>" alt="" width="20" height="20" />
            </a>
        </nav>
    </header>

    <section class="rss-home-hero" aria-label="Rocket Science Sports programs">
        <a class="rss-home-hero__panel rss-home-hero__panel--silver" href="<?= $block->escapeUrl($block->getUrl('catalog/category/view', ['id' => 47])) ?>">
            <img class="rss-home-hero__art" src="<?= $block->escapeUrl($silverPodiumUrl) ?>" alt="" />
            <span class="rss-home-hero__label"><?= $block->escapeHtml(__('Custom Teamwear')) ?></span>
        </a>
        <a class="rss-home-hero__panel rss-home-hero__panel--gold" href="<?= $block->escapeUrl($block->getUrl('catalog/category/view', ['id' => 65])) ?>">
            <img class="rss-home-hero__art" src="<?= $block->escapeUrl($goldPodiumUrl) ?>" alt="" />
            <span class="rss-home-hero__label"><?= $block->escapeHtml(__('Performance Gear')) ?></span>
        </a>
        <a class="rss-home-hero__panel rss-home-hero__panel--bronze" href="<?= $block->escapeUrl($block->getUrl('catalog/category/view', ['id' => 491])) ?>">
            <img class="rss-home-hero__art" src="<?= $block->escapeUrl($bronzePodiumUrl) ?>" alt="" />
            <span class="rss-home-hero__label"><?= $block->escapeHtml(__('Schools + Orgs')) ?></span>
        </a>
    </section>

    <nav class="rss-home-nav" aria-label="Primary programs" data-mage-init='{"js/rss-home-nav":{}}'>
        <?php foreach ($sections as $section): ?>
            <?php
            $categoryId = (int)$section['id'];
            $categoryNode = $categoryNodes[$categoryId] ?? null;
            $categoryUrl = $categoryNode && $categoryHelper
                ? $categoryHelper->getCategoryUrl($categoryNode)
                : $block->getUrl('catalog/category/view', ['id' => $categoryId]);
            $children = [];

            if ($categoryNode) {
                foreach ($categoryNode->getChildren() as $child) {
                    $isActive = $child->getData('is_active');
                    $includeInMenu = $child->getData('include_in_menu');

                    if (($isActive !== null && !(bool)$isActive) || ($includeInMenu !== null && !(bool)$includeInMenu)) {
                        continue;
                    }

                    $children[] = $child;
                }
            }

            $toggleId = 'rss-home-nav-toggle-' . $categoryId;
            $panelId = 'rss-home-nav-panel-' . $categoryId;
            ?>
            <div class="rss-home-nav__group">
                <button class="rss-home-nav__item rss-home-nav__toggle"
                        type="button"
                        id="<?= $block->escapeHtmlAttr($toggleId) ?>"
                        aria-expanded="false"
                        aria-controls="<?= $block->escapeHtmlAttr($panelId) ?>">
                    <span class="rss-home-nav__label"><?= $block->escapeHtml(__($section['label'])) ?></span>
                    <span class="rss-home-nav__chevron" aria-hidden="true">
                        <img src="<?= $block->escapeUrl($chevronIconUrl) ?>" alt="" width="40" height="40" />
                    </span>
                </button>

                <div class="rss-home-nav__panel"
                     id="<?= $block->escapeHtmlAttr($panelId) ?>"
                     role="region"
                     aria-labelledby="<?= $block->escapeHtmlAttr($toggleId) ?>"
                     hidden>
                    <div class="rss-home-nav__links">
                        <a class="rss-home-nav__subitem rss-home-nav__subitem--all" href="<?= $block->escapeUrl($categoryUrl) ?>">
                            <?= $block->escapeHtml(__('View All %1', $section['label'])) ?>
                        </a>
                        <?php foreach ($children as $child): ?>
                            <a class="rss-home-nav__subitem" href="<?= $block->escapeUrl($categoryHelper->getCategoryUrl($child)) ?>">
                                <?= $block->escapeHtml($child->getName()) ?>
                            </a>
                        <?php endforeach; ?>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </nav>

    <section class="rss-home-links" aria-label="Company and support links">
        <div class="rss-home-links__column">
            <a href="<?= $block->escapeUrl($baseUrl . 'about-us') ?>"><?= $block->escapeHtml(__('Company')) ?></a>
