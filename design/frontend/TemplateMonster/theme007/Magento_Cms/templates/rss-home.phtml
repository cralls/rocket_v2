    ['label' => 'Schools + Orgs', 'id' => 491],
    ['label' => 'Performance Gear', 'id' => 65],
    ['label' => 'Private Label', 'id' => 492],
    ['label' => 'Events', 'id' => 124],
];

$categoryHelper = $block->getData('category_helper');
$categoryNodes = [];

if ($categoryHelper) {
    foreach ($categoryHelper->getStoreCategories(true, false, true) as $storeCategory) {
        $categoryNodes[(int)$storeCategory->getId()] = $storeCategory;
    }
}

