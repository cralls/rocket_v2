<?php
/** RSS 2026-11-14: shared homepage and subpage program navigation. */
$sections = [
    ['label' => 'Custom Teamwear', 'id' => 47],
    ['label' => 'Schools + Orgs', 'id' => 491],
    ['label' => 'Performance Gear', 'id' => 65],
    ['label' => 'Private Label', 'id' => 492],
    ['label' => 'Events', 'id' => 124],
];

$secondaryGroupIds = [47, 491, 492];
$parentAnchorIds = [492, 124];

$categoryNodes = [];
foreach ($block->getRootChildren() as $storeCategory) {
    $categoryNodes[(int)$storeCategory->getId()] = $storeCategory;
}

$getVisibleChildren = static function ($category) {
    $children = [];

    if (!$category) {
        return $children;
    }

    foreach ($category->getChildrenCategories()->addAttributeToSelect(['is_active', 'include_in_menu']) as $child) {
        if (!$child->getIsActive()) {
            continue;
        }

        if ($child->hasData('include_in_menu') && !$child->getIncludeInMenu()) {
            continue;
        }

        $children[] = $child;
    }

    return $children;
};

$getMenuUrl = static function ($category, $anchorParent) use ($block) {
    if ($anchorParent) {
        return $block->getCategoryUrl($anchorParent) . '#category-' . (int)$category->getId();
    }

    return $block->getCategoryUrl($category);
};

$chevronIconUrl = $block->getViewFileUrl('images/rss/chevron-down.svg');
?>
<nav class="rss-home-nav" aria-label="Primary programs" data-mage-init='{"js/rss-home-nav":{}}'>
    <?php foreach ($sections as $section): ?>
        <?php
        $categoryId = (int)$section['id'];
        $categoryNode = $categoryNodes[$categoryId] ?? null;
        $children = $getVisibleChildren($categoryNode);
        $usesSecondaryGroups = in_array($categoryId, $secondaryGroupIds, true) && count($children) >= 2;
        $anchorParent = in_array($categoryId, $parentAnchorIds, true) ? $categoryNode : null;

        $toggleId = 'rss-home-nav-toggle-' . $categoryId;
        $panelId = 'rss-home-nav-panel-' . $categoryId;
        ?>
        <div class="rss-home-nav__group<?= $usesSecondaryGroups ? ' rss-home-nav__group--secondary' : '' ?>">
            <button class="rss-home-nav__item rss-home-nav__toggle"
                    type="button"
                    id="<?= $block->escapeHtmlAttr($toggleId) ?>"
                    aria-expanded="false"
                    aria-controls="<?= $block->escapeHtmlAttr($panelId) ?>">
                <span class="rss-home-nav__label"><?= $block->escapeHtml(__($section['label'])) ?></span>
                <span class="rss-home-nav__chevron" aria-hidden="true">
                    <img src="<?= $block->escapeUrl($chevronIconUrl) ?>" alt="" width="40" height="40" />
                </span>
            </button>

            <div class="rss-home-nav__panel"
                 id="<?= $block->escapeHtmlAttr($panelId) ?>"
                 role="region"
                 aria-labelledby="<?= $block->escapeHtmlAttr($toggleId) ?>"
                 hidden>
                <?php if ($usesSecondaryGroups): ?>
                    <div class="rss-home-nav__secondary" data-rss-secondary-tabs>
                        <div class="rss-home-nav__tabs" role="tablist" aria-label="<?= $block->escapeHtmlAttr(__('%1 sections', $section['label'])) ?>">
                            <?php foreach ($children as $index => $secondaryCategory): ?>
                                <?php
                                $secondaryId = (int)$secondaryCategory->getId();
                                $tabId = 'rss-home-nav-tab-' . $categoryId . '-' . $secondaryId;
                                $tabPanelId = 'rss-home-nav-tabpanel-' . $categoryId . '-' . $secondaryId;
                                $isSelected = $index === 0;
                                ?>
                                <button class="rss-home-nav__tab<?= $isSelected ? ' _active' : '' ?>"
                                        type="button"
                                        id="<?= $block->escapeHtmlAttr($tabId) ?>"
                                        role="tab"
                                        aria-selected="<?= $isSelected ? 'true' : 'false' ?>"
                                        aria-controls="<?= $block->escapeHtmlAttr($tabPanelId) ?>"
                                        tabindex="<?= $isSelected ? '0' : '-1' ?>">
                                    <?= $block->escapeHtml($secondaryCategory->getName()) ?>
                                </button>
                            <?php endforeach; ?>
                        </div>

                        <?php foreach ($children as $index => $secondaryCategory): ?>
                            <?php
                            $secondaryId = (int)$secondaryCategory->getId();
                            $tabId = 'rss-home-nav-tab-' . $categoryId . '-' . $secondaryId;
                            $tabPanelId = 'rss-home-nav-tabpanel-' . $categoryId . '-' . $secondaryId;
                            $secondaryChildren = $getVisibleChildren($secondaryCategory);
                            ?>
                            <div class="rss-home-nav__tabpanel"
                                 id="<?= $block->escapeHtmlAttr($tabPanelId) ?>"
                                 role="tabpanel"
                                 aria-labelledby="<?= $block->escapeHtmlAttr($tabId) ?>"
                                 <?= $index === 0 ? '' : 'hidden' ?>>
                                <div class="rss-home-nav__tablinks">
                                    <?php if ($anchorParent): ?>
                                        <a class="rss-home-nav__tablink"
                                           href="<?= $block->escapeUrl($getMenuUrl($secondaryCategory, $anchorParent)) ?>">
                                            <?= $block->escapeHtml(__('View %1', $secondaryCategory->getName())) ?>
                                        </a>
                                    <?php endif; ?>
                                    <?php foreach ($secondaryChildren as $secondaryChild): ?>
                                        <?php
                                        $secondaryChildName = (string)$secondaryChild->getName();
                                        $isAction = stripos($secondaryChildName, 'start ') === 0;
                                        ?>
                                        <a class="rss-home-nav__tablink<?= $isAction ? ' rss-home-nav__tablink--action' : '' ?>"
                                           href="<?= $block->escapeUrl($getMenuUrl($secondaryChild, $anchorParent)) ?>">
                                            <?= $block->escapeHtml($secondaryChildName) ?>
                                        </a>
                                    <?php endforeach; ?>
                                </div>
                            </div>
                        <?php endforeach; ?>
                    </div>
                <?php else: ?>
                    <div class="rss-home-nav__secondary rss-home-nav__direct">
                        <div class="rss-home-nav__tablinks">
                            <?php foreach ($children as $child): ?>
                                <?php
                                $childName = (string)$child->getName();
                                $isAction = stripos($childName, 'start ') === 0;
                                ?>
                                <a class="rss-home-nav__tablink<?= $isAction ? ' rss-home-nav__tablink--action' : '' ?>"
                                   href="<?= $block->escapeUrl($getMenuUrl($child, $anchorParent)) ?>">
                                    <?= $block->escapeHtml($childName) ?>
                                </a>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endif; ?>
            </div>
        </div>
    <?php endforeach; ?>
</nav>
