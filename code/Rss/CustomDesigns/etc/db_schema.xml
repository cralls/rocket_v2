<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="rss_custom_designs" resource="default" engine="innodb" comment="Custom Design Requests">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true" unsigned="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="request_type" nullable="false" length="16" comment="New/Updated"/>
        <column xsi:type="varchar" name="sales_person_name" nullable="false" length="255" comment="Sales Person Name"/>
        <column xsi:type="varchar" name="sales_person_email" nullable="false" length="255" comment="Sales Person Email"/>
        <column xsi:type="varchar" name="customer_name" nullable="false" length="255" comment="Customer Name"/>
        <column xsi:type="varchar" name="priority" nullable="false" length="16" comment="Urgent/Regular"/>
        <column xsi:type="date" name="date_needed" nullable="false" comment="Date Art Needed"/>
        <column xsi:type="varchar" name="sportswear_type" nullable="true" length="64" comment="Type of Sportswear"/>
        <column xsi:type="varchar" name="product_other" nullable="true" length="255" comment="Other Requested Product"/>
        <column xsi:type="varchar" name="level" nullable="true" length="32" comment="Level"/>
        <column xsi:type="varchar" name="level_other" nullable="true" length="255" comment="Level Other (write-in)"/>
        <column xsi:type="varchar" name="logos_url" nullable="false" length="512" comment="Link to Logos"/>
        <column xsi:type="varchar" name="pantone_pref" nullable="true" length="255" comment="Pantone Colors Preference"/>
        <column xsi:type="varchar" name="design_style" nullable="false" length="16" comment="WILD/MODERATE/CONSERVATIVE"/>
        <column xsi:type="text"    name="comments" nullable="true" comment="Additional Comments"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="true" on_update="true" default="NULL" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <index referenceId="RSS_CUSTDESIGNS_EMAIL_IDX">
            <column name="sales_person_email"/>
        </index>
        <index referenceId="RSS_CUSTDESIGNS_DATE_NEEDED_IDX">
            <column name="date_needed"/>
        </index>
    </table>
    <table name="rss_custom_designs_bom" resource="default" engine="innodb" comment="Custom Design BOM Materials">
	    <column xsi:type="int" name="material_id" nullable="false" identity="true" unsigned="true" comment="Material ID"/>
	    <column xsi:type="varchar" name="material_code" nullable="true" length="64" comment="Material Code"/>
	    <column xsi:type="varchar" name="material_name" nullable="false" length="255" comment="Material Name"/>
	    <column xsi:type="varchar" name="material_name_cn" nullable="true" length="255" comment="Original Chinese Name"/>
	    <column xsi:type="varchar" name="material_type" nullable="true" length="64" comment="Material Type"/>
	    <column xsi:type="text" name="description" nullable="true" comment="Description"/>
	    <column xsi:type="smallint" name="is_active" nullable="false" unsigned="true" default="1" comment="Is Active"/>
	    <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
	    <column xsi:type="timestamp" name="updated_at" nullable="true" default="NULL" on_update="true" comment="Updated At"/>
	
	    <constraint xsi:type="primary" referenceId="PRIMARY">
	        <column name="material_id"/>
	    </constraint>
	
	    <constraint xsi:type="unique" referenceId="RSS_CUSTOM_DESIGNS_BOM_MATERIAL_NAME_UNQ">
	        <column name="material_name"/>
	    </constraint>
	
	    <constraint xsi:type="unique" referenceId="RSS_CUSTOM_DESIGNS_BOM_MATERIAL_CODE_UNQ">
	        <column name="material_code"/>
	    </constraint>
	
	    <index referenceId="RSS_CUSTOM_DESIGNS_BOM_MATERIAL_TYPE_IDX">
	        <column name="material_type"/>
	    </index>
	
	    <index referenceId="RSS_CUSTOM_DESIGNS_BOM_IS_ACTIVE_IDX">
	        <column name="is_active"/>
	    </index>
	</table>
	
	<table name="rss_custom_designs_pattern_bom" resource="default" engine="innodb" comment="Custom Design Pattern BOM Relations">
	    <column xsi:type="int" name="relation_id" nullable="false" identity="true" unsigned="true" comment="Relation ID"/>
	    <column xsi:type="int" name="pattern_id" nullable="false" unsigned="true" comment="Pattern ID"/>
	    <column xsi:type="int" name="material_id" nullable="false" unsigned="true" comment="Material ID"/>
	    <column xsi:type="int" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
	    <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
	    <column xsi:type="timestamp" name="updated_at" nullable="true" default="NULL" on_update="true" comment="Updated At"/>
	
	    <constraint xsi:type="primary" referenceId="PRIMARY">
	        <column name="relation_id"/>
	    </constraint>
	
	    <constraint xsi:type="unique" referenceId="RSS_CUSTOM_DESIGNS_PATTERN_BOM_UNQ">
	        <column name="pattern_id"/>
	        <column name="material_id"/>
	    </constraint>
	
	    <index referenceId="RSS_CUSTOM_DESIGNS_PATTERN_BOM_PATTERN_ID_IDX">
	        <column name="pattern_id"/>
	    </index>
	
	    <index referenceId="RSS_CUSTOM_DESIGNS_PATTERN_BOM_MATERIAL_ID_IDX">
	        <column name="material_id"/>
	    </index>
	</table>
	
	<table name="rss_production_request_pattern" resource="default" engine="innodb" comment="Production Request Pattern Relations">
	    <column xsi:type="int" name="relation_id" nullable="false" identity="true" unsigned="true" comment="Relation ID"/>
	    <column xsi:type="int" name="production_request_id" nullable="false" unsigned="true" comment="Production Request ID"/>
	    <column xsi:type="int" name="pattern_id" nullable="false" unsigned="true" comment="Pattern ID"/>
	    <column xsi:type="int" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
	    <column xsi:type="smallint" name="is_primary" nullable="false" unsigned="true" default="0" comment="Is Primary"/>
	    <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
	    <column xsi:type="timestamp" name="updated_at" nullable="true" default="NULL" on_update="true" comment="Updated At"/>
	
	    <constraint xsi:type="primary" referenceId="PRIMARY">
	        <column name="relation_id"/>
	    </constraint>
	
	    <constraint xsi:type="unique" referenceId="RSS_PRODUCTION_REQUEST_PATTERN_UNQ">
	        <column name="production_request_id"/>
	        <column name="pattern_id"/>
	    </constraint>
	
	    <index referenceId="RSS_PRODUCTION_REQUEST_PATTERN_REQUEST_ID_IDX">
	        <column name="production_request_id"/>
	    </index>
	
	    <index referenceId="RSS_PRODUCTION_REQUEST_PATTERN_PATTERN_ID_IDX">
	        <column name="pattern_id"/>
	    </index>
	
	    <index referenceId="RSS_PRODUCTION_REQUEST_PATTERN_PRIMARY_IDX">
	        <column name="is_primary"/>
	    </index>
	</table>
</schema>
