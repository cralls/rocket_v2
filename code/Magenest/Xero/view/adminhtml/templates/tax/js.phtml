<script>
    require([
        'jquery',
        'Magento_Ui/js/modal/alert'
    ], function ($, alert) {
        $(document).ready(function(){
            var submitButton =  $('#submit_mapping');
            submitButton.click(function () {
                $.ajax({
                    type: "POST",
                    url: "<?= $block->escapeUrl($block->getUrl('xero/tax/savemapping'))?>",
                    data: $('#mapping_form').serialize(),
                    showLoader: true,
                    success: function (response) {
                        alert({
                            content: response.msg,
                            title: 'Save Mapping'
                        });
                    },
                    fail: function(response) {
                        alert({
                            content: 'Failed to save mapping',
                            title: 'Save Mapping'
                        });
                    }
                });
            });

            var updateButton = $('#update_tax_rates');
            updateButton.click( function () {
                $.ajax({
                    type: "GET",
                    url: "<?= $block->escapeUrl($block->getUrl('xero/tax/updatetaxrates'))?>",
                    data: {
                        website_id: '<?= $block->getRequest()->getParam('website') ? : 0; ?>'
                    },
                    showLoader: true,
                    success: function () {
                        location.reload();
                    },
                    fail: function () {
                        location.reload();
                    }
                })
            })
        });

    });
</script>